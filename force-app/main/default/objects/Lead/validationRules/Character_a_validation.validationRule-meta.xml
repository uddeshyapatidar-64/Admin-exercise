<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Character_a_validation</fullName>
    <active>true</active>
    <errorConditionFormula>CONTAINS( MID( Email , 5, 8), &quot;a&quot; )</errorConditionFormula>
    <errorMessage>Email should not contain character &quot;a&quot; between 5th to 12th char.</errorMessage>
</ValidationRule>
