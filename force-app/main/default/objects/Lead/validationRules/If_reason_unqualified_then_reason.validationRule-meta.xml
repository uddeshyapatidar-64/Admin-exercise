<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>If_reason_unqualified_then_reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status, &quot;Unqualified&quot;), ISBLANK( Reason__c ), NOT(ISNEW()))</errorConditionFormula>
    <errorMessage>Exe 7.3 : Reason for lead being unqualified must be mentioned.</errorMessage>
</ValidationRule>
