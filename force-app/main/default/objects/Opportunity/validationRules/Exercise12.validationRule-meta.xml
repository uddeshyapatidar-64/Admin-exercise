<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exercise12</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    MONTH(CloseDate) &lt;&gt; MONTH(TODAY()),
    YEAR(CloseDate) &lt;&gt; YEAR(TODAY())
